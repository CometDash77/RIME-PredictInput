{
  "name": "rime-predict",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Strict-TypeScript reimplementation of the RIME model-prediction sidecar. File-IPC compatible with the librime-lua filter.",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "rime-predict": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "python tools/oracle/dump_fixtures.py",
    "selftest": "node dist/cli/main.js selftest",
    "verify": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && vitest run",
    "build:exe": "pnpm run build && node tools/sidecar-exe/build.mjs",
    "eval:build": "node dist/eval/main.js build",
    "eval:check": "node dist/eval/main.js check",
    "eval:run": "node dist/eval/main.js run"
  },
  "dependencies": {
    "koffi": "2.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@yao-pkg/pkg": "^6.23.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
